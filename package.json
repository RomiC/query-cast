{
  "name": "query-cast",
  "version": "2.1.1",
  "description": "Query params parser and cast micro-library",
  "keywords": [
    "query",
    "query parameters",
    "query parser",
    "querystring",
    "searchparams",
    "url parser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:RomiC/query-cast.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:test": "tsdown -c tsdown.tests.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "pretest": "npm run build:test",
    "pretest:smoke": "npm run build",
    "test": "c8 --reporter=text --reporter=lcov --include=dist node --test specs/*.spec.js",
    "test:no-coverage": "node --test specs/*.spec.js",
    "test:smoke": "node ./scripts/smoke-cjs.cjs && node ./scripts/smoke-esm.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "typeable": "2.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "yargs": "^18.0.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "oxlint --fix",
    "*.{js,ts,mjs,cjs,json,md,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22"
  }
}
